# Shared password required to sign in to the data room.
DATAROOM_PASSWORD=

# Random secret used to sign session cookies. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Postgres connection string. Works with any Postgres provider
# (Vercel Postgres, Neon, Supabase, Railway, self-hosted, etc.) —
# tables are created automatically on first connection.
DATABASE_URL=
